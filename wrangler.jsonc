{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "photolog",
  "main": "src/worker/index.tsx",
  "compatibility_date": "2026-10-30",
  "build": { "command": "node scripts/build.mjs", "watch_dir": ["src/client", "src/shared"] },
  // Fonts, favicons and the hashed client bundles. Requests that match a file
  // are served directly; everything else reaches the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photolog",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "photolog" }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "production" },
  "workers_dev": false,
  "routes": [{ "pattern": "photolog.tillmannbedau.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
